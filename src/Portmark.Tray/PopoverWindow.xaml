<Window x:Class="Portmark.Tray.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portmark"
        Width="360" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True">

    <Window.Resources>
        <!-- Drawn as paths rather than font glyphs. A missing glyph renders as a box, and an icon
             that might be a box is worse than no icon. -->
        <Geometry x:Key="IconBolt">M13,2 L5,14 L11,14 L10,22 L19,10 L13,10 Z</Geometry>
        <Geometry x:Key="IconPort">M6,8 L18,8 A4,4 0 0 1 18,16 L6,16 A4,4 0 0 1 6,8 Z</Geometry>
        <Geometry x:Key="IconDisplay">M3,5 L21,5 L21,16 L3,16 Z M9,20 L15,20</Geometry>
        <Geometry x:Key="IconWarn">M12,3 L22,20 L2,20 Z</Geometry>
        <Geometry x:Key="IconChip">M8,8 L16,8 L16,16 L8,16 Z M11,4 L11,8 M13,4 L13,8 M11,16 L11,20 M13,16 L13,20 M4,11 L8,11 M4,13 L8,13 M16,11 L20,11 M16,13 L20,13</Geometry>
        <Geometry x:Key="IconRefresh">M12,5 A7,7 0 1 0 19,12 M12,5 L12,1 M12,5 L16,5</Geometry>
        <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>
        <Geometry x:Key="IconMore">M4,7 L20,7 M4,12 L20,12 M4,17 L13,17</Geometry>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="12" Margin="12"
            BorderBrush="#1E293B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="14,12,8,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconPort}" Fill="{StaticResource Accent}"
                          Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="portmark" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DetailButton" Style="{StaticResource IconButton}"
                            Click="OnToggleDetail" ToolTip="Show technical detail">
                        <Path Data="{StaticResource IconMore}" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnRefresh" ToolTip="Refresh">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnQuit" ToolTip="Quit">
                        <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Divider}"/>

            <Border DockPanel.Dock="Bottom" Padding="14,8,14,10">
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,10,10,2">
                <StackPanel x:Name="Items"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
