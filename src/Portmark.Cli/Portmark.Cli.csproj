<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Portmark.Cli</RootNamespace>
    <AssemblyName>portmark</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Portmark.Core\Portmark.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local WMI only, for the OS caption in 'portmark report'. The registry's ProductName still
         says "Windows 10" on Windows 11, which is the wrong thing to put in a hardware report. -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>
</Project>
